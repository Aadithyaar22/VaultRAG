# --- VaultRAG configuration (copy to .env; never commit .env) ---
VAULTRAG_DB_PATH=backend/data/vaultrag.db
VAULTRAG_SECRET=change-me-to-a-long-random-string
VAULTRAG_TOKEN_TTL_SECONDS=28800

# LLM provider: openai_compatible | extractive | none
#  openai_compatible -> any OpenAI-style /chat/completions endpoint (e.g. Groq)
#  extractive        -> OFFLINE, NON-GENERATIVE: returns best-matching authorized sentences
#                       (explicitly labelled in the UI; for tests/benchmarks/no-network demos)
#  none              -> chat returns a clear "model not configured" error
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=30

# Embeddings: hashing (dependency-free, deterministic) | openai_compatible
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Retrieval / RSEG
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.08
RSEG_MAX_REGENERATIONS=1
CACHE_ENABLED=true

# Enables /api/admin/demo/* controls (disable outside demos)
DEMO_MODE=true
